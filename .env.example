# ── API ─────────────────────────────────────────────────────────────────────
# Leave unset on Vercel: the app uses same-origin /api/v1 (vercel.json → Railway). No CORS issues.
# VITE_API_BASE_URL=/api/v1

# Only if you must call Railway directly from the browser (needs backend CORS for your domain):
# VITE_API_BASE_URL=https://dukaplusbackend-production.up.railway.app/api/v1

# Local dev: Vite proxy (default). To hit Railway directly from the browser:
# VITE_API_FORCE_DIRECT=true
# VITE_BACKEND_URL=https://dukaplusbackend-production.up.railway.app

# Local backend instead of Railway:
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_URL=http://localhost:8000

# Ensure Railway CORS_ORIGINS includes your Vercel URL, e.g.:
# https://dukalangu-red.vercel.app,http://localhost:5173
# (Backend also allows *.vercel.app via regex.)
